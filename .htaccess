# =========================================================
# Sistema Académico - Protección de Apache
# =========================================================

# No listar directorios sin index
Options -Indexes

# No seguir enlaces simbólicos fuera del árbol de la app
Options -SymLinksIfOwnerMatch

# Página de entrada por defecto
DirectoryIndex index.php index.html PORTADA/index.html

# La portada vive en PORTADA/www.ravensbourne.ac.uk/index.html (sus imágenes,
# estilos y fuentes usan rutas relativas a esa carpeta). La raíz de la app
# redirige allí para que el sitio y el archivo abierto directamente (file://)
# usen las mismas rutas.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} ^(.*)/$
    RewriteRule ^$ %1/PORTADA/www.ravensbourne.ac.uk/index.html [R=302,L]
    RewriteCond %{REQUEST_URI} ^(.*)/PORTADA/?$
    RewriteRule ^PORTADA/?$ %1/PORTADA/www.ravensbourne.ac.uk/index.html [R=302,L]
</IfModule>

# Bloquear archivos sensibles por extensión (dumps, logs, claves...)
<IfModule mod_authz_core.c>
    <FilesMatch "\.(sql|log|ini|bak|old|env|dist|lock)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(sql|log|ini|bak|old|env|dist|lock)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Evitar que se ejecute como PHP cualquier archivo dentro de backups/legado
<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>

# Cabecera base de seguridad si Apache está detrás de un proxy HTTPS
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
